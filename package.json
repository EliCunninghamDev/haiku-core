{
  "name": "haiku-core",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "Deterministic 5-7-5 verification for terminals and CI",
  "license": "MIT",
  "author": "Elijah Cunningham <accounts@elijahcunningham.dev>",
  "homepage": "https://github.com/EliCunninghamDev/haiku-core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EliCunninghamDev/haiku-core.git"
  },
  "bugs": {
    "url": "https://github.com/EliCunninghamDev/haiku-core/issues"
  },
  "funding": "https://github.com/sponsors/EliCunninghamDev",
  "keywords": ["haiku", "bun", "rust", "poetry", "ci", "syllables"],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "build:rust": "cargo build --release --manifest-path rust/Cargo.toml",
    "test:rust": "cargo test --manifest-path rust/Cargo.toml",
    "fmt": "cargo fmt --manifest-path rust/Cargo.toml",
    "verify": "bun run typecheck && bun test && bun run test:rust",
    "demo": "vhs demo.tape"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
